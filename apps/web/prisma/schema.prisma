generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum TokenVolatilityRegime {
  LOW
  MEDIUM
  HIGH
}

enum TradingSessionStatus {
  OPEN
  CLOSED
}

enum SessionTradeStatus {
  OPEN
  WIN
  LOSS
}

enum CandleInterval {
  M15
  H1
  H4
  H12
  D1
}

model TokenTrade {
  id              BigInt                @id @default(autoincrement())
  symbol          String
  pnlPct          Float
  hitTP           Boolean
  hitSL           Boolean
  maxDrawdownPct  Float
  durationCandles Int
  regime          TokenVolatilityRegime
  closedAt        DateTime              @default(now())

  @@index([symbol, closedAt(sort: Desc)])
  @@index([symbol, regime, closedAt(sort: Desc)])
}

model TradingSession {
  id                  BigInt               @id @default(autoincrement())
  status              TradingSessionStatus @default(OPEN)
  startedAt           DateTime             @default(now())
  endedAt             DateTime?
  startingBalanceUsd  Float
  currentBalanceUsd   Float
  leverage            Float
  takeProfitPct       Float
  stopLossPct         Float
  maxConcurrentTrades Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  trades              SessionTrade[]
  opportunities       SessionOpportunity[]

  @@index([status, startedAt(sort: Desc)])
}

model SessionTrade {
  id             BigInt           @id @default(autoincrement())
  sessionId      BigInt
  externalTradeId String          @unique
  symbol         String
  direction      String
  signalType     String
  entryScore     Float
  weightedScore  Float
  takeProfitPct  Float
  stopLossPct    Float
  stakeUsd       Float
  entryPrice     Float
  tpPrice        Float
  slPrice        Float
  leverage       Float
  status         SessionTradeStatus @default(OPEN)
  openedAt       DateTime
  closedAt       DateTime?
  resultPct      Float?
  resultUsd      Float?
  closeReason    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  session        TradingSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, openedAt(sort: Desc)])
  @@index([symbol, openedAt(sort: Desc)])
}

model SessionOpportunity {
  id                 BigInt         @id @default(autoincrement())
  sessionId          BigInt
  symbol             String
  direction          String
  signalType         String
  entryScore         Float
  weightedScore      Float
  takeProfitPct      Float
  stopLossPct        Float
  volatilityPct      Float
  marketCondition    String
  availableForEntry  Boolean
  reason             String
  createdAt          DateTime       @default(now())
  session            TradingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Desc)])
  @@index([symbol, createdAt(sort: Desc)])
}

model ExchangeTradeHistory {
  id               BigInt   @id @default(autoincrement())
  provider         String
  dedupeKey        String   @unique
  exchangeTradeId  String?
  symbol           String
  direction        String
  marginCoin       String?
  status           String
  openedAt         DateTime?
  closedAt         DateTime
  entryPrice       Float?
  closePrice       Float?
  leverage         Float?
  qty              Float?
  realizedPnlUsd   Float?
  roiPct           Float?
  rawPayload       Json
  syncedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([provider, closedAt(sort: Desc)])
  @@index([symbol, closedAt(sort: Desc)])
  @@index([exchangeTradeId])
}

model LiveOrderLedger {
  id          BigInt   @id @default(autoincrement())
  provider    String
  symbol      String
  perpToken   String
  direction   String
  orderType   String
  source      String
  status      String
  localTradeId String?
  clientId    String?
  orderId     String?
  positionId  String?
  stakeUsd    Float?
  leverage    Float?
  entryPrice  Float?
  tpPrice     Float?
  slPrice     Float?
  openedAt    DateTime?
  closedAt    DateTime?
  closeReason String?
  meta        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, clientId])
  @@unique([provider, orderId])
  @@index([provider, symbol, createdAt(sort: Desc)])
  @@index([positionId])
  @@index([status, updatedAt(sort: Desc)])
}

model ScanState {
  id        Int      @id
  payload   Json
  analyzedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TradeRuntimeState {
  id                  Int      @id @default(autoincrement())
  tenantId            String   @unique
  accountBalanceUsd   Float
  dailyStartBalanceUsd Float
  openTrades          Json
  recentClosedTrades  Json
  metrics             Json
  updatedAt           DateTime @updatedAt
}

enum BackfillTokenStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  NO_DATA
  SKIPPED
}

model MarketCandle {
  id        BigInt         @id @default(autoincrement())
  symbol    String
  assetType AssetType      @default(CRYPTO)
  interval  CandleInterval
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  createdAt DateTime       @default(now())

  @@unique([symbol, assetType, interval, timestamp])
  @@index([interval, timestamp])
  @@index([symbol, assetType, interval, timestamp(sort: Desc)])
  @@index([assetType, interval, timestamp(sort: Desc)])
}

model BackfillToken {
  id              BigInt                @id @default(autoincrement())
  symbol          String                @unique
  status          BackfillTokenStatus   @default(PENDING)
  lastAttemptedAt DateTime?
  lastSuccessAt   DateTime?
  lastError       String?
  dataAvailableFrom DateTime?
  candleCount     Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, updatedAt(sort: Desc)])
  @@index([symbol, status])
}

model TelegramWatchlistEntry {
  id        BigInt   @id @default(autoincrement())
  chatId    BigInt
  symbol    String
  createdAt DateTime @default(now())

  @@unique([chatId, symbol])
  @@index([chatId, createdAt(sort: Desc)])
}

model TelegramAlertEvent {
  id        BigInt   @id @default(autoincrement())
  dedupeKey String
  stage     String
  symbol    String
  direction String
  signalType String
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dedupeKey, stage])
  @@index([symbol, direction, signalType, sentAt(sort: Desc)])
  @@index([stage, sentAt(sort: Desc)])
}

enum TradingMode {
  DAY_TRADING
  SWING_TRADING
}

enum TradingStyle {
  DAY_TRADING
  SWING
  LONG_TERM
  SPOT_SHORT
}

enum AssetType {
  CRYPTO
  STOCK
  FUTURE
  OPTION
}

enum OptionSide {
  CALL
  PUT
}

enum TradingProfileStyle {
  SCALP
  DAY
  SWING
  LONG_TERM
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  apiKeys   ApiKey[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  image          String?
  emailVerified  DateTime?
  passwordHash   String?  // Optional for OAuth users
  organizationId String
  role           String   @default("member") // admin, member, viewer
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configurations UserConfiguration[]
  stylePolicies  StyleMarketPolicy[]
  alertEvents    AlertEvent[]
  simulationProfile UserSimulationProfile?
  tradingProfile UserTradingProfile?
  accounts       Account[]
  sessions       Session[]

  @@index([organizationId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  keyHash        String   @unique
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([revokedAt])
}

model PlatformConfiguration {
  id                   String   @id @default(cuid())
  exchangeCredentials  Json     // { schwab: { clientId, clientSecret, ... }, coinbase: { key, secret }, ... }
  backfillPolicy       Json     // { hoursWindow: 90, maxSymbolsPerRun: 50, ... }
  indicatorDefaults    Json     // { stochPeriod: 14, emaLengths: [9, 21, 55], ... }
  alertChannels        Json     // { telegram: { token, chatId }, email: {...}, webhook: {...} }
  riskDefaults         Json     // { maxConcurrentTrades: 3, maxRiskPerTrade: 2, ... }
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model UserConfiguration {
  id              String   @id @default(cuid())
  userId          String
  tradingStyle    TradingStyle @default(SWING)
  symbolUniverse  String[] // ["AAPL", "BTC", "MANA"]
  riskPerTrade    Float    @default(2.0) // percentage
  maxConcurrentTrades Int  @default(3)
  dayTradeSettings Json? // { maxHoldMinutes: 1440, tpPct: 2.0, slPct: 1.5 }
  swingSettings    Json? // { maxHoldDays: 14, tpPct: 5.0, slPct: 3.0 }
  longTermSettings Json? // { maxHoldDays: 90, tpPct: 20.0, slPct: 10.0 }
  spotSettings     Json? // { maxHoldDays: 7, tpPct: 3.0, slPct: 2.0 }
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tradingStyle])
  @@index([userId])
}

model UserSimulationProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  initialBalanceUsd     Float    @default(10000)
  riskPerTradePct       Float    @default(1.5)
  leverage              Float    @default(5)
  maxOpenTrades         Int      @default(8)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserTradingProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  style           TradingProfileStyle @default(SWING)
  riskLevel       RiskLevel @default(MEDIUM)
  minConfidence   Int      @default(60) // percentage
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StyleMarketPolicy {
  id                   String         @id @default(cuid())
  userId               String
  tradingStyle         TradingStyle
  allowedAssetTypes    AssetType[]
  allowedIntervals     CandleInterval[]
  refreshSeconds       Int            @default(60)
  maxUniverseSize      Int            @default(50)
  includeExtendedHours Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tradingStyle])
  @@index([userId, tradingStyle])
}

model DerivativeInstrument {
  id               String     @id @default(cuid())
  symbol           String     @unique
  assetType        AssetType
  venue            String
  underlyingSymbol String
  expiration       DateTime?
  strike           Float?
  optionSide       OptionSide?
  contractSize     Float?
  tickSize         Float?
  metadata         Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([assetType, underlyingSymbol])
  @@index([venue, assetType])
}

model StrategyConfig {
  id                    Int      @id @default(1)
  tradingMode           TradingMode @default(DAY_TRADING)
  enableFibonacci       Boolean  @default(true)
  enableCipherB         Boolean  @default(true)
  enableVWAP            Boolean  @default(true)
  enableEMA             Boolean  @default(true)
  enableStructure       Boolean  @default(true)
  enableOrderFlow       Boolean  @default(true)
  enableATR             Boolean  @default(true)
  enableRSI             Boolean  @default(true)
  fiboTargetLevels      String   @default("0.23,0.38,0.5,0.618,0.786") // comma-separated
  cipherBSensitivity    Float    @default(0.85)
  dayTradingMaxHoldTime Int      @default(1440) // minutes
  swingTradingMaxHoldTime Int    @default(10080) // minutes (7 days)
  dayTradingTpPct       Float    @default(2.0)
  swingTradingTpPct     Float    @default(5.0)
  dayTradingSlPct       Float    @default(1.5)
  swingTradingSlPct     Float    @default(3.0)
  updatedAt             DateTime @updatedAt
}

enum OrderSide {
  LONG
  SHORT
}

enum OrderType {
  MARKET
  LIMIT
  STOP
  STOP_LIMIT
}

enum OrderStatus {
  PENDING
  PARTIAL
  FILLED
  CANCELLED
  REJECTED
}

enum PositionStatus {
  OPEN
  CLOSED
  CLOSING
}

model Position {
  id              String          @id @default(cuid())
  userId          String
  symbol          String
  assetType       AssetType
  side            OrderSide
  quantity        Float
  entryPrice      Float
  currentPrice    Float
  pnl             Float           @default(0) // unrealized
  pnlPercent      Float           @default(0)
  status          PositionStatus  @default(OPEN)
  brokerAccount   String? // OKX account ID, etc.
  brokerPositionId String? // exchange position ID
  entryAt         DateTime
  closedAt        DateTime?
  closePrice      Float?
  realizedPnl     Float?
  stopLoss        Float?
  takeProfit      Float?
  notes           String?
  metadata        Json? // exchange-specific fields
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  orders          Order[]

  @@index([userId, status])
  @@index([userId, symbol, assetType])
  @@index([status, updatedAt(sort: Desc)])
}

model Order {
  id              String          @id @default(cuid())
  userId          String
  positionId      String?
  symbol          String
  assetType       AssetType
  side            OrderSide
  type            OrderType
  quantity        Float
  price           Float?
  filledQuantity  Float           @default(0)
  filledPrice     Float?
  status          OrderStatus     @default(PENDING)
  broker          String // OKX, HYPERLIQUID, COINBASE, SCHWAB
  brokerOrderId   String?
  brokerAccount   String?
  clientOrderId   String          @unique @default(cuid())
  createdAt       DateTime        @default(now())
  filledAt        DateTime?
  cancelledAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  metadata        Json? // exchange-specific order data
  position        Position?       @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([symbol, status])
  @@index([broker, brokerOrderId])
  @@index([createdAt(sort: Desc)])
}

enum SignalState {
  READY
  CAUTION
  BLOCKED
  UNRESOLVED
}

model AlertEvent {
  id              String         @id @default(cuid())
  userId          String
  symbol          String
  assetType       AssetType
  tradingStyle    TradingStyle
  interval        CandleInterval
  signalState     SignalState
  signalType      String? // VIOLENT_MOVE_LONG_STOCH_UP, HTF_GATE_CONFLICT, etc.
  recommendation  String? // "ENTER_LONG", "ENTER_SHORT", "WAIT", "CLOSE"
  metrics         Json? // {rsi: 45.2, sma20: 42500, sma50: 42300, momentum: 1.2, ...}
  priceContext    Json? // {open, high, low, close, volume}
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol, tradingStyle, createdAt(sort: Desc)])
  @@index([symbol, assetType, tradingStyle, signalState, createdAt(sort: Desc)])
  @@index([signalState, createdAt(sort: Desc)])
  @@index([userId, signalState, createdAt(sort: Desc)])
}

model RuntimeSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
